# =============================================================================
# OpenShell-on-Kubernetes launchable — configuration
# Copy to .env and fill in MODEL_API_KEY. scripts/setup.sh reads this file,
# renders the Ansible secrets/overrides from it, and runs the playbook.
# (On Brev you can instead set these as the Launchable's environment variables.)
# =============================================================================

# ---- Model (REQUIRED for agents to think) -----------------------------------
# Any OpenAI-compatible endpoint: NVIDIA API Catalog (build.nvidia.com), OpenAI,
# a self-hosted vLLM/NIM. LiteLLM holds this key; agents reach LiteLLM through
# the `litellm` provider and only ever see a placeholder.
MODEL_API_KEY=""
MODEL_BASE_URL="https://integrate.api.nvidia.com/v1"
MODEL_NAME="meta/llama-3.3-70b-instruct"

# ---- Stack toggles ----------------------------------------------------------
# Kyverno guardrails on sandbox pods (no host network/PID/IPC). Lightweight.
ENABLE_KYVERNO="true"
# Prometheus + Grafana + Loki + Alloy + Tempo. Also turns on OpenShell's OCSF
# audit export to Loki and the agent trace relay to Tempo.
ENABLE_MONITORING="true"

# ---- Sign-in, ingress and the console ---------------------------------------
# Keycloak (OIDC), Envoy Gateway, Grafana SSO and the OpenShell Console
# (github.com/ai-openshell/console). People sign in with Keycloak; the gateway
# accepts no anonymous calls. The lab's own CLI uses an mTLS operator certificate.
ENABLE_SSO="true"
# Headlamp Kubernetes dashboard (OIDC). Off by default.
ENABLE_HEADLAMP="false"

# Public URLs. LEAVE EMPTY on Brev: setup.sh reads the instance's links from
# /etc/brev/environment-context.json (the link on port 3001 is the site, 3002 the
# console) and otherwise derives https://<prefix>-<brevid>.<domain of any link>.
# PUBLIC_BASE_URL: training site, /auth (Keycloak), /grafana  -> host port ENVOY_HOST_PORT
# CONSOLE_URL:     the OpenShell Console (its own host)        -> host port CONSOLE_HOST_PORT
# Create one Brev Secure Link per URL, with the matching name and port.
PUBLIC_BASE_URL=""
CONSOLE_URL=""
BREV_URL_PREFIX="openshell"
CONSOLE_URL_PREFIX="console"
BREV_URL_DOMAIN=""           # empty = detect from the Brev links (fallback brevlab.com)
ENVOY_HOST_PORT="3001"
CONSOLE_HOST_PORT="3002"
# In-cluster Envoy NodePorts (rarely need changing).
ENVOY_WEB_NODEPORT="30080"
ENVOY_GRPC_NODEPORT="30081"

# ---- Agent fleet ------------------------------------------------------------
# Create agent-0..N-1 at the end of provisioning (baseline policy + litellm provider).
CREATE_FLEET="true"
FLEET_SIZE="1"
# Agent binary scripts/fleet runs for `fleet task` (default: openclaw).
AGENT_CMD="openclaw"

# ---- OpenClaw UI (optional) -------------------------------------------------
# OpenClaw's own web Control UI from agent-0, through a persistent
# `openshell forward` tunnel to host port OPENCLAW_UI_PORT. Its password is
# generated into .sso-secrets.env (or set OPENCLAW_GATEWAY_PASSWORD here).
ENABLE_OPENCLAW_UI="true"
OPENCLAW_UI_PORT="30789"
OPENCLAW_UI_URL=""            # derived like the others: https://openclaw-<brevid>.<domain>
OPENCLAW_UI_URL_PREFIX="openclaw"

# ---- Training site ----------------------------------------------------------
# Lessons + a live in-browser terminal (training/). Separate from the platform;
# set false for the platform only.
ENABLE_TRAINING="true"
TRAINING_PORT="3000"

# ---- Networking -------------------------------------------------------------
# NodePort the OpenShell gateway is published on for the VM's CLI (30000-32767).
GATEWAY_NODEPORT="30808"

# ---- Advanced ---------------------------------------------------------------
# Run only part of the playbook, e.g. ANSIBLE_TAGS=gateway (tags: ansible/README.md).
# ANSIBLE_TAGS=""
