# =============================================================================
# OpenShell-on-Kubernetes launchable — configuration
# Copy to .env and fill in OPENSHELL_API_KEY. scripts/setup.sh reads this file,
# renders the Ansible secrets/overrides from it, and runs the playbook.
# (On Brev you can instead set these as the Launchable's environment variables.)
# =============================================================================

# ---- Inference (REQUIRED) ---------------------------------------------------
# Any OpenAI-compatible endpoint: NVIDIA API Catalog (build.nvidia.com), OpenAI,
# a self-hosted vLLM/NIM, or an internal gateway. The agent never sees this key —
# it calls https://inference.local; the in-sandbox proxy injects the credential.
OPENSHELL_API_KEY=""
OPENSHELL_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENSHELL_MODEL="meta/llama-3.3-70b-instruct"

# ---- Stack toggles ----------------------------------------------------------
# gVisor (runsc) sandbox isolation. Strongly recommended — it's the security
# story for running untrusted agent code on a shared node.
ENABLE_GVISOR="true"

# Kyverno policy guardrails (incl. require-gvisor). Lightweight; good teaching aid.
ENABLE_KYVERNO="true"

# Full observability stack (Prometheus + Grafana + Loki + Alloy + Tempo).
# Grafana is published behind the Envoy ingress at <PUBLIC_BASE_URL>/grafana when
# SSO is on (see ENABLE_SSO); otherwise on NodePort 30030.
ENABLE_MONITORING="true"

# ---- Single sign-on + ingress (Keycloak + Envoy Gateway) --------------------
# Deploys Keycloak (OIDC), patches the kube-apiserver for OIDC RBAC, installs the
# Envoy Gateway, and path-routes the UIs under ONE public host:
#   <base>/auth (Keycloak)  <base>/grafana  <base>/headlamp  <base>/console
# plus Headlamp (k8s dashboard) and Grafana SSO. The OpenShell gateway gRPC is
# exposed via Envoy on ENVOY_GRPC_NODEPORT.
ENABLE_SSO="true"
# The Console itself stays OPEN (no login) even with SSO on — a learner on
# their own single-tenant box doesn't need a login wall there. Grafana/
# Keycloak/Headlamp are still gated by ENABLE_SSO above. Set true to also put
# the console behind Keycloak.
ENABLE_CONSOLE_SSO="false"
# Headlamp Kubernetes dashboard (OIDC SSO). Off by default — kubectl + the
# console cover dashboarding; flip on if you want a full k8s web dashboard.
ENABLE_HEADLAMP="false"
# OpenShell Console (fleet/sandbox management UI) is built INTO the teaching site
# and served at <site>:WORKSHOP_PORT/console — no separate image or route needed.
# It talks to the gateway on GATEWAY_NODEPORT and runs in open mode (the gateway
# is unauthenticated). Nothing to toggle here.

# Public HTTPS base URL that fronts the Envoy web port (the OIDC issuer origin —
# must resolve identically from your browser, the gateway pod, and the apiserver).
# LEAVE EMPTY to auto-derive: https://<BREV_URL_PREFIX>-<brevid>.<BREV_URL_DOMAIN>
# (brevid is read from the host). Set PUBLIC_BASE_URL explicitly to override.
PUBLIC_BASE_URL=""
BREV_URL_PREFIX="openshell"
BREV_URL_DOMAIN="brevlab.com"
# Envoy Gateway NodePorts: web (path-routed UIs) + gRPC (OpenShell gateway).
ENVOY_WEB_NODEPORT="30080"
ENVOY_GRPC_NODEPORT="30081"

# ---- Agent fleet ------------------------------------------------------------
# Create an initial fleet of OpenClaw sandboxes at the end of provisioning.
CREATE_FLEET="true"
FLEET_SIZE="1"

# Agent binary scripts/fleet execs inside a sandbox for `fleet task` (default:
# openclaw — the gateway's default sandbox image). For an OpenAI/LiteLLM backend
# use codex/opencode; for an Anthropic-format backend use claude.
#
# KNOWN GAP, PARTIALLY CLOSED (verified live, 2026-09): openclaw's own inference
# call does NOT route through inference.local via env vars the way
# claude/codex/opencode do — it uses its own provider/credential system
# (`openclaw onboard` / `openclaw models auth`), separate from the
# OPENAI_BASE_URL/ANTHROPIC_BASE_URL convention the other three honor directly.
# When ENABLE_OPENCLAW_UI=true, ansible/roles/18-openclaw-forward now runs
# that onboarding automatically (baseUrl https://inference.local/v1 — the /v1
# is required, a bare https://inference.local falls outside the supervisor's
# special-cased interception path and gets denied by the normal egress policy
# instead — surfaces as a misleading "authentication failed, HTTP 403" whose
# real gateway-log cause is "connection not allowed by policy"). With ENABLE_
# OPENCLAW_UI=false (fleet task's own path, same sandbox otherwise), that
# onboarding never runs, so the gap still applies there — same fix, run
# manually inside the sandbox. No explicit policy grant is needed for
# inference.local itself (contrary to an earlier version of this note) — it's
# intercepted before policy evaluation for ANY binary, verified live with a
# bare `curl` on a fresh sandbox with no added rules.
# The community sandbox images (`--from base`/`ollama`) with claude/codex/
# opencode pre-installed were confirmed live to route through inference.local
# correctly out of the box — see docs.nvidia.com/openshell/about/supported-agents
# for their policy-coverage status. Codex additionally needs a `websocket`
# (not just `rest`) protocol grant for endpoints OTHER than inference.local —
# its Responses API connects over wss://.
AGENT_CMD="openclaw"

# ---- OpenClaw UI (optional) -------------------------------------------------
# Exposes OpenClaw's own web control UI (chat interface, device pairing) via
# a persistent `openshell forward` tunnel — its port lives inside the sandbox's
# sealed network namespace, so a plain NodePort/Ingress can't reach it directly.
ENABLE_OPENCLAW_UI="true"
OPENCLAW_UI_PORT="30789"
# Control UI's own login (unrelated to Keycloak/the console) — change this for
# anything beyond a local demo box.
OPENCLAW_GATEWAY_PASSWORD="openshell-wad26"
# The browser-facing URL for the OpenClaw UI, shown as a link in the console/site
# header. On Brev this MUST be its own Secure Link (a separate subdomain, e.g.
# https://openclaw-<brevid>.<domain>) — unlike GATEWAY_NODEPORT/WORKSHOP_PORT,
# Brev's edge doesn't let you reach an arbitrary port on the SAME public host, so
# "same host, different port" doesn't work here. LEAVE EMPTY to auto-derive as
# https://<OPENCLAW_UI_URL_PREFIX>-<brevid>.<BREV_URL_DOMAIN> (same brevid/domain
# the main site's PUBLIC_BASE_URL uses, above) — or set it explicitly for a
# non-Brev host.
OPENCLAW_UI_URL=""
OPENCLAW_UI_URL_PREFIX="openclaw"

# ---- Teaching website -------------------------------------------------------
# A Next.js site (lessons + a live in-browser terminal wired to this cluster).
# Served on WORKSHOP_PORT — expose it on Brev to open it in your browser.
ENABLE_WORKSHOP="true"
WORKSHOP_PORT="3000"

# ---- Networking -------------------------------------------------------------
# NodePort the OpenShell gateway is published on (expose this port on Brev for
# remote CLI access). Must be in 30000-32767.
GATEWAY_NODEPORT="30808"

# ---- Advanced ---------------------------------------------------------------
# Run only part of the playbook, e.g. ANSIBLE_TAGS=gateway (see ansible/README.md
# for the tag list). Leave empty for a full bring-up.
# ANSIBLE_TAGS=""
