[Unit]
Description=OpenShell forward: host {{ openclaw_ui_port }} -> OpenClaw UI ({{ openclaw_ui_agent }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_env.SUDO_USER | default(ansible_user_id) }}
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
ExecStart={{ _openshell_bin.stdout }} --gateway fleet forward start 0.0.0.0:{{ openclaw_ui_port }} {{ openclaw_ui_agent }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
