#!/bin/sh
# OpenClaw launcher: runs OpenClaw on its private Node 24 (the system node is 22).
#
# On first use it seeds $OPENCLAW_CONFIG_PATH from /etc/openclaw/openclaw.json,
# which points OpenClaw at the lab's LiteLLM gateway:
#   LITELLM_BASE_URL  default http://litellm.litellm.svc.cluster.local:4000/v1
#   LITELLM_MODEL     default "default" (a LiteLLM alias for the lab's model)
#   LITELLM_API_KEY   a placeholder from the `litellm` provider; the OpenShell
#                     supervisor swaps in the real key on allowed requests only.
#
# One-shot runs (`openclaw agent ... --message ...`) read stdin from /dev/null
# when stdin is not a terminal: `openshell sandbox exec -- cmd` keeps stdin
# open and a reader would block. Set OPENCLAW_KEEP_STDIN=1 to pass stdin.
set -eu
: "${LITELLM_BASE_URL:=http://litellm.litellm.svc.cluster.local:4000/v1}"
: "${LITELLM_MODEL:=default}"
: "${OPENCLAW_STATE_DIR:=${HOME:-/sandbox}/.openclaw}"
: "${OPENCLAW_CONFIG_PATH:=$OPENCLAW_STATE_DIR/openclaw.json}"
: "${TMPDIR:=/tmp}"
: "${SQLITE_TMPDIR:=$TMPDIR}"
export LITELLM_BASE_URL LITELLM_MODEL OPENCLAW_STATE_DIR OPENCLAW_CONFIG_PATH TMPDIR SQLITE_TMPDIR

if [ -z "${LITELLM_API_KEY:-}" ]; then
  echo "openclaw: LITELLM_API_KEY is not set; attach the provider: openshell sandbox provider attach <sandbox> litellm" >&2
  export LITELLM_API_KEY=unset
fi

mkdir -p "$OPENCLAW_STATE_DIR"
if [ ! -f "$OPENCLAW_CONFIG_PATH" ]; then
  cp /etc/openclaw/openclaw.json "$OPENCLAW_CONFIG_PATH"
  chmod 600 "$OPENCLAW_CONFIG_PATH"
fi

NODE=/usr/local/lib/openclaw/node/bin/node
MAIN=/usr/local/lib/openclaw/lib/node_modules/openclaw/openclaw.mjs

oneshot=false
if [ "${1:-}" = agent ]; then
  for a in "$@"; do
    case "$a" in -m|--message|--message=*) oneshot=true ;; esac
  done
fi
if $oneshot && [ ! -t 0 ] && [ "${OPENCLAW_KEEP_STDIN:-0}" != 1 ]; then
  exec "$NODE" "$MAIN" "$@" </dev/null
fi
exec "$NODE" "$MAIN" "$@"
