// OpenClaw config seeded into $OPENCLAW_CONFIG_PATH on first start (JSON5).
// Every model call goes to the lab's LiteLLM gateway (OpenAI-compatible).
// ${VAR} values are substituted by OpenClaw at load time; LITELLM_API_KEY is
// the provider placeholder the OpenShell supervisor swaps for the real key.
{
  models: {
    // Only this provider: no catalog discovery of others.
    mode: "replace",
    providers: {
      litellm: {
        baseUrl: "${LITELLM_BASE_URL}",
        apiKey: "${LITELLM_API_KEY}",
        api: "openai-completions",
        // LiteLLM is a cluster-internal (private) address.
        request: { allowPrivateNetwork: true },
        models: [
          {
            id: "${LITELLM_MODEL}",
            name: "LiteLLM ${LITELLM_MODEL}",
            reasoning: false,
            input: ["text"],
            contextWindow: 131072,
            maxTokens: 8192,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      model: { primary: "litellm/${LITELLM_MODEL}" },
    },
  },
}
