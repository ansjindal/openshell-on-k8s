#!/usr/bin/env bash
# fleet — scale and drive a fleet of OpenShell sandboxes via the openshell CLI.
# Each sandbox starts from the lab baseline policy (deny all network) with the
# `litellm` provider attached: the agent calls LiteLLM's own API with a
# placeholder key that the supervisor swaps for the real one.
#
#   fleet up [N]            create N long-lived sandboxes agent-0..N-1 (default FLEET_SIZE, or 1)
#   fleet down              delete all fleet sandboxes
#   fleet status            openshell sandbox list + the pods behind them
#   fleet task "<prompt>" [agent-i|all]   run the agent on a prompt across the fleet (parallel)
#   fleet logs <agent-i>    OpenShell logs for one sandbox (gateway + supervisor)
#   fleet shell <agent-i>   open an interactive shell inside one sandbox
#
# Env (from .env or shell):
#   FLEET_SIZE   default count for `up`
#   AGENT_CMD    agent binary run inside the sandbox for tasks (default: openclaw)
#   PROVIDER     provider to attach (default: litellm)
#   OPENSHELL_WORKSPACE  workspace (default: default); its sandboxes run in the
#                namespace openshell-<gateway id>-<workspace>, e.g. openshell-lab-default
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${ENV_FILE:-${HERE}/.env}"
[ -f "${ENV_FILE}" ] && { set -a; source "${ENV_FILE}"; set +a; }

export KUBECONFIG="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
export NO_COLOR=1
FLEET_SIZE="${FLEET_SIZE:-1}"
AGENT_CMD="${AGENT_CMD:-openclaw}"
PROVIDER="${PROVIDER:-litellm}"
# Managed workspaces: the gateway (id "lab") creates one namespace per workspace.
SANDBOX_NS="${SANDBOX_NS:-openshell-${GATEWAY_ID:-lab}-${OPENSHELL_WORKSPACE:-default}}"
GATEWAY_NODEPORT="${GATEWAY_NODEPORT:-30808}"
POLICY="${HERE}/manifests/policies/baseline.yaml"
OSH=(openshell --gateway fleet)

die() { echo "ERROR: $*" >&2; exit 1; }
command -v openshell >/dev/null 2>&1 || die "openshell CLI not found — run ./scripts/setup.sh"
command -v kubectl   >/dev/null 2>&1 || die "kubectl not found — is k3s installed? (run ./scripts/setup.sh)"

# The CLI talks to the gateway as the lab operator (mTLS, OU=operator). Set it
# up for this user if that hasn't happened yet (fresh SSH session, other user).
ensure_gateway() {
  "${OSH[@]}" status >/dev/null 2>&1 && "${OSH[@]}" sandbox list >/dev/null 2>&1 && return 0
  bash "${HERE}/scripts/lab-cli-setup.sh" fleet "${GATEWAY_NODEPORT}" >/dev/null
}

cmd_up() {
  local n="${1:-${FLEET_SIZE}}"
  [[ "${n}" =~ ^[0-9]+$ ]] || die "usage: fleet up [N]"
  ensure_gateway
  echo "Scaling fleet to ${n} sandbox(es)..."
  local existing; existing="$("${OSH[@]}" sandbox list 2>/dev/null | awk 'NR>1{print $1}')"
  for i in $(seq 0 $((n - 1))); do
    if echo "${existing}" | grep -qx "agent-${i}"; then echo "  agent-${i} (already exists)"; continue; fi
    # --detach: create and return. `sleep infinity` is the sandbox's main
    # process; when it exits the sandbox ends, so it must keep running.
    timeout 300 "${OSH[@]}" sandbox create --name "agent-${i}" --provider "${PROVIDER}" \
        --policy "${POLICY}" --memory 3Gi --env LITELLM_MODEL=default \
        --no-tty --detach -- sleep infinity </dev/null >/dev/null 2>&1 \
      && echo "  created agent-${i}" \
      || echo "  agent-${i}: create failed — check 'openshell logs agent-${i}'"
  done
  echo ""
  cmd_status
}

cmd_down() {
  ensure_gateway
  echo "Tearing down the fleet..."
  "${OSH[@]}" sandbox list 2>/dev/null | awk '/^agent-/ {print $1}' | while read -r s; do
    "${OSH[@]}" sandbox delete "${s}" >/dev/null 2>&1 && echo "  deleted ${s}" || true
  done
}

cmd_status() {
  ensure_gateway
  echo "== openshell sandboxes =="
  "${OSH[@]}" sandbox list 2>/dev/null || echo "(CLI unavailable)"
  echo ""
  echo "== Kubernetes (${SANDBOX_NS}): one workload pod + one supervisor pod per sandbox =="
  kubectl -n "${SANDBOX_NS}" get sandboxes.agents.x-k8s.io 2>/dev/null || echo "(none)"
  kubectl -n "${SANDBOX_NS}" get pods -o wide 2>/dev/null || true
  local total ready
  total="$("${OSH[@]}" sandbox list 2>/dev/null | awk 'NR>1' | wc -l | tr -d ' ')"
  ready="$("${OSH[@]}" sandbox list 2>/dev/null | awk 'NR>1 && $NF=="Ready"' | wc -l | tr -d ' ')"
  echo ""
  echo "Fleet ready: ${ready:-0}/${total:-0}"
}

cmd_task() {
  local prompt="${1:-}" target="${2:-all}"
  [ -n "${prompt}" ] || die 'usage: fleet task "<prompt>" [agent-i|all]'
  ensure_gateway
  local agents=()
  if [ "${target}" = "all" ]; then
    while IFS= read -r a; do [ -n "${a}" ] && agents+=("${a}"); done < <(
      "${OSH[@]}" sandbox list 2>/dev/null | awk '/^agent-/ {print $1}')
  else
    agents=("${target}")
  fi
  [ "${#agents[@]}" -gt 0 ] || die "no agents — run 'fleet up' first"

  # OpenClaw one-shot: `agent --local --agent main --message <text>` runs the
  # embedded agent in this process (no OpenClaw Gateway) against LiteLLM.
  # Other agents use the common `-p "<prompt>"` print mode.
  local -a agent_argv
  if [ "${AGENT_CMD}" = "openclaw" ]; then
    agent_argv=("${AGENT_CMD}" agent --local --agent main --message "${prompt}")
  else
    agent_argv=("${AGENT_CMD}" -p "${prompt}")
  fi

  echo "Running '${AGENT_CMD}' on ${#agents[@]} agent(s) in parallel..."
  local pids=()
  for a in "${agents[@]}"; do
    ( out="$("${OSH[@]}" sandbox exec -n "${a}" -- "${agent_argv[@]}" 2>&1 || true)"
      # agent-0 runs OpenClaw's own Gateway (the Control UI); then --local is
      # refused and the turn goes through that Gateway instead.
      if [ "${AGENT_CMD}" = "openclaw" ] && printf '%s' "${out}" | grep -q "A Gateway is running"; then
        out="$("${OSH[@]}" sandbox exec -n "${a}" -- "${AGENT_CMD}" agent --agent main --message "${prompt}" 2>&1 || true)"
      fi
      printf '\n── [%s] ───────────────\n%s\n' "${a}" "${out}" ) &
    pids+=("$!")
  done
  for p in "${pids[@]}"; do wait "${p}" || true; done
  echo ""; echo "All agents finished."
}

cmd_shell() {
  local a="${1:-agent-0}"
  ensure_gateway
  echo "Opening a shell inside ${a} (exit to return)..."
  # --tty allocates a PTY; without it an interactive /bin/bash starts with no terminal,
  # prints no prompt, and the session appears to hang. (`openshell sandbox connect` is the
  # other option, but exec --tty keeps the one-shot semantics this wrapper expects.)
  "${OSH[@]}" sandbox exec --tty -n "${a}" -- /bin/bash || "${OSH[@]}" sandbox exec --tty -n "${a}" -- /bin/sh
}

cmd_logs() {
  local a="${1:-}"; [ -n "${a}" ] || die "usage: fleet logs <agent-i>"
  ensure_gateway
  # Gateway + supervisor logs for the sandbox, including the OCSF lines for
  # every network decision the supervisor made.
  "${OSH[@]}" logs "${a}" -n 200 --tail
}

case "${1:-}" in
  up)     shift; cmd_up "$@";;
  down)   cmd_down;;
  status) cmd_status;;
  task)   shift; cmd_task "$@";;
  shell)  shift; cmd_shell "$@";;
  logs)   shift; cmd_logs "$@";;
  *) grep -E '^#( |$)' "$0" | sed 's/^# \{0,1\}//'; exit 1;;
esac
