#!/usr/bin/env python3
"""skill-lint: check Agent Skills folders against the spec (agentskills.io/specification).

  ./scripts/skill-lint skills/k8s-triage [skills/other …]

Checks what every client relies on: SKILL.md exists and starts with YAML
frontmatter; `name` is 1-64 chars of a-z, 0-9 and single hyphens and matches the
folder; `description` is 1-1024 chars; optional fields have the right shape.
The official reference validator is skills-ref in github.com/agentskills/agentskills.
"""
import os, re, sys

NAME = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
KNOWN = {"name", "description", "license", "compatibility", "metadata", "allowed-tools"}

def frontmatter(text):
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    fm, key = {}, None
    for line in text[4:end].splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line[0] in " \t":           # nested (metadata) or folded value
            if key == "metadata":
                fm.setdefault("metadata", {})
                k, _, v = line.strip().partition(":")
                fm["metadata"][k.strip()] = v.strip()
            elif key:
                fm[key] = (fm.get(key) or "") + " " + line.strip()
            continue
        key, _, val = line.partition(":")
        key, val = key.strip(), val.strip()
        fm[key] = {} if key == "metadata" and not val else val.strip("'\"")
    return fm

def lint(path):
    errs = []
    folder = os.path.basename(os.path.normpath(path))
    f = os.path.join(path, "SKILL.md")
    if not os.path.isfile(f):
        return [f"{path}: no SKILL.md"]
    fm = frontmatter(open(f, encoding="utf-8").read())
    if fm is None:
        return [f"{f}: must start with YAML frontmatter between --- lines"]
    name, desc = fm.get("name", ""), fm.get("description", "")
    if not name:
        errs.append("name: missing")
    elif not (len(name) <= 64 and NAME.match(name)):
        errs.append(f"name: '{name}' must be 1-64 chars of a-z, 0-9 and single hyphens")
    elif name != folder:
        errs.append(f"name: '{name}' must match the folder name '{folder}'")
    if not desc:
        errs.append("description: missing")
    elif len(desc) > 1024:
        errs.append(f"description: {len(desc)} chars, max 1024")
    if "compatibility" in fm and len(fm["compatibility"]) > 500:
        errs.append("compatibility: max 500 chars")
    if "metadata" in fm and not isinstance(fm["metadata"], dict):
        errs.append("metadata: must be a map of strings")
    for k in fm:
        if k not in KNOWN:
            errs.append(f"{k}: not a field of the spec (clients may ignore it)")
    return [f"{f}: {e}" for e in errs]

paths = sys.argv[1:] or [os.path.join("skills", d) for d in sorted(os.listdir("skills")) if os.path.isdir(os.path.join("skills", d))]
bad = 0
for p in paths:
    errs = lint(p)
    bad += bool(errs)
    print("\n".join(errs) if errs else f"ok  {p}")
sys.exit(1 if bad else 0)
